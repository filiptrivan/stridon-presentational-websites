#!/usr/bin/env bash
#
# Pre-push guard: `pnpm preflight` (lint + unit tests, ~6s cold), so a
# deterministic red never leaves the machine. Installed by the root `prepare`
# script; bypass a known-safe push with: git push --no-verify.
#
# NEVER add `test:integration` here — that lane writes to production.
# Rationale for all of the above: CLAUDE.md → Preflight.
#
# Weaker than CI by design: it skips when node_modules is absent, and Vercel's
# `next build` remains the only full-build check.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

if [ ! -d node_modules ]; then
    echo "pre-push: node_modules missing — skipping preflight (CI gates still apply)." >&2
    exit 0
fi

echo "pre-push: pnpm preflight (lint + unit tests)..." >&2
pnpm preflight
